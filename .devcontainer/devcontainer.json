{
  "name": "DAYFLOW cloud development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-bookworm",
  "remoteUser": "node",
  "forwardPorts": [4178],
  "portsAttributes": {
    "4178": {
      "label": "DAYFLOW private preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "node scripts/verify.mjs",
  "postStartCommand": "node scripts/start-cloud.mjs"
}
